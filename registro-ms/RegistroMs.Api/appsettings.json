{
  "Database": {
    "Provider": "MySql",
    "ConnectionString": "Server=localhost;Port=3306;Database=registro_db;User=root;Password=;CharSet=utf8mb4;"
  },
  "DatabaseResilience": {
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 3,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "Jwt": {
    "Key": "RegistroMs-Dev-Secret-Key-Min-32-Chars!",
    "Issuer": "registro-ms",
    "Audience": "registro-app"
  },
  "Auth": {
    "AccessTokenMinutes": 5,
    "InactivityMinutes": 5,
    "RefreshTokenHours": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
