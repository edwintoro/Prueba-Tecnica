@page "/materias"
@inject ICatalogoApiClient Catalogo
@inject ITokenStorage TokenStorage
@inject AuthBridgeService AuthBridge
@implements IDisposable

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Materias — Administración</h2>
    <a href="/home" target="_top" class="btn btn-outline-secondary">← Volver</a>
</div>

<p class="text-muted">
    Máximo <strong>10 materias</strong> en el catálogo (@_materias.Count / 10).
    Cada profesor puede dictar máximo <strong>2 materias</strong>.
</p>

@if (!string.IsNullOrEmpty(_mensaje)) { <div class="alert alert-success">@_mensaje</div> }
@if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger">@_error</div> }

@if (!_listo)
{
    <p>Cargando...</p>
}
else if (!AppRoles.IsAdministrador(TokenStorage.Current?.Rol))
{
    <div class="alert alert-warning">Acceso restringido a administradores.</div>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary"
                disabled="@(_materias.Count >= 10)"
                @onclick="() => _modo = Modo.Crear">
            + Nueva Materia
        </button>
    </div>
    @if (_materias.Count >= 10)
    {
        <div class="alert alert-info">Se alcanzó el límite de 10 materias. Elimine una para crear otra.</div>
    }

    @if (_modo == Modo.Lista)
    {
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <label class="form-label mb-1">Buscar</label>
                <input type="search" class="form-control" placeholder="Nombre, profesor o código (ID)..."
                       value="@_busqueda" @oninput="e => _busqueda = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="col-md-6 text-md-end text-muted small">
                @_materiasFiltradas.Count() de @_materias.Count registro(s)
            </div>
        </div>

        <table class="table table-striped">
            <thead class="table-primary">
                <tr><th>Código</th><th>Materia</th><th>Profesor</th><th>Créditos</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @if (!_materiasFiltradas.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center">No hay resultados para la búsqueda.</td></tr>
                }
                @foreach (var m in _materiasFiltradas)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td>@m.Nombre</td>
                        <td>@m.ProfesorNombre</td>
                        <td>@m.Creditos</td>
                        <td>
                            <button class="btn btn-sm btn-secondary me-1" @onclick="() => Editar(m)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(m.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="col-md-6">
            <h4>@(_modo == Modo.Crear ? "Nueva" : "Editar") Materia</h4>
            <EditForm Model="_form" OnValidSubmit="Guardar">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="_form.Nombre" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Créditos</label>
                    <InputNumber class="form-control" @bind-Value="_form.Creditos" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Profesor</label>
                    <input type="search" class="form-control mb-2" placeholder="Buscar profesor por nombre o código..."
                           value="@_busquedaProfesor" @oninput="e => _busquedaProfesor = e.Value?.ToString() ?? string.Empty" />
                    <InputSelect class="form-select" @bind-Value="_form.ProfesorId">
                        <option value="0">Seleccione...</option>
                        @foreach (var p in ProfesoresParaFormulario)
                        {
                            var count = _materias.Count(m => m.ProfesorId == p.Id && m.Id != _editId);
                            <option value="@p.Id">[@p.Id] @p.Nombre (@count/2 materias)</option>
                        }
                    </InputSelect>
                </div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
            </EditForm>
        </div>
    }
}

@code {
    private enum Modo { Lista, Crear, Editar }

    private Modo _modo = Modo.Lista;
    private List<MateriaModel> _materias = [];
    private List<ProfesorModel> _profesores = [];
    private FormModel _form = new();
    private int? _editId;
    private bool _listo;
    private string? _mensaje;
    private string? _error;
    private string _busqueda = string.Empty;
    private string _busquedaProfesor = string.Empty;

    private IEnumerable<MateriaModel> _materiasFiltradas =>
        Filtrar(_materias, m => m.Id, m => m.Nombre, m => m.ProfesorNombre);

    private IEnumerable<ProfesorModel> ProfesoresParaFormulario
    {
        get
        {
            var q = _busquedaProfesor.Trim();
            if (string.IsNullOrEmpty(q)) return _profesores;
            if (int.TryParse(q, out var codigo))
                return _profesores.Where(p => p.Id == codigo);
            return _profesores.Where(p => p.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<T> Filtrar<T>(IEnumerable<T> items, Func<T, int> id, params Func<T, string>[] textos)
    {
        var q = _busqueda.Trim();
        if (string.IsNullOrEmpty(q)) return items;
        if (int.TryParse(q, out var codigo))
            return items.Where(i => id(i) == codigo);
        return items.Where(i => textos.Any(t => t(i).Contains(q, StringComparison.OrdinalIgnoreCase)));
    }

    protected override async Task OnInitializedAsync()
    {
        TokenStorage.Changed += OnAuthChanged;
        AuthBridge.Ready += OnAuthChanged;
        await CargarAsync();
    }

    private async void OnAuthChanged() => await InvokeAsync(CargarAsync);

    private async Task CargarAsync()
    {
        _listo = false;
        for (var i = 0; i < 60 && !TokenStorage.IsAuthenticated; i++)
            await Task.Delay(100);

        if (!AppRoles.IsAdministrador(TokenStorage.Current?.Rol))
        {
            _listo = true;
            StateHasChanged();
            return;
        }

        try
        {
            _materias = (await Catalogo.GetMateriasAsync()).ToList();
            _profesores = (await Catalogo.GetProfesoresAsync()).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }

        _listo = true;
    }

    private void Editar(MateriaModel m)
    {
        _editId = m.Id;
        _form = new FormModel { Nombre = m.Nombre, Creditos = m.Creditos, ProfesorId = m.ProfesorId };
        _modo = Modo.Editar;
    }

    private async Task Guardar()
    {
        _error = null;
        _mensaje = null;
        if (_form.ProfesorId <= 0) { _error = "Seleccione un profesor."; return; }

        try
        {
            if (_modo == Modo.Crear)
            {
                var creado = await Catalogo.CreateMateriaAsync(new CreateMateriaModel(_form.Nombre, _form.Creditos, _form.ProfesorId));
                if (creado is null) { _error = "No se pudo crear (límite de 10 materias o 2 por profesor)."; return; }
                _mensaje = "Materia creada.";
            }
            else if (_editId.HasValue)
            {
                var ok = await Catalogo.UpdateMateriaAsync(_editId.Value, new UpdateMateriaModel(_form.Nombre, _form.Creditos, _form.ProfesorId));
                if (ok is null) { _error = "No se pudo actualizar (revise límite de 2 materias por profesor)."; return; }
                _mensaje = "Materia actualizada.";
            }
            _modo = Modo.Lista;
            await CargarAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Eliminar(int id)
    {
        try
        {
            await Catalogo.DeleteMateriaAsync(id);
            _mensaje = "Materia eliminada.";
            await CargarAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void Cancelar() { _modo = Modo.Lista; _editId = null; _form = new(); _busquedaProfesor = string.Empty; }

    public void Dispose()
    {
        TokenStorage.Changed -= OnAuthChanged;
        AuthBridge.Ready -= OnAuthChanged;
    }

    private sealed class FormModel
    {
        public string Nombre { get; set; } = string.Empty;
        public int Creditos { get; set; } = 3;
        public int ProfesorId { get; set; }
    }
}
