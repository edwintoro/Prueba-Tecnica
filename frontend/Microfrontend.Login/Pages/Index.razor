@page "/"
@inject IAuthApiClient AuthApi
@inject IJSRuntime JS

<div class="row justify-content-center">
    <div class="col-md-5">
        <h3 class="mb-4">@(_registro ? "Registro de estudiante" : "Iniciar sesión")</h3>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger d-flex justify-content-between align-items-start">
                <span>@_error</span>
                <button type="button" class="btn-close" @onclick="LimpiarError"></button>
            </div>
        }

        @if (_registro)
        {
            <EditForm Model="_register" OnValidSubmit="Registrar">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="_register.Nombre" @bind-Value:after="LimpiarError" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_register.Email" @bind-Value:after="LimpiarError" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <InputText type="password" class="form-control" @bind-Value="_register.Password" @bind-Value:after="LimpiarError" />
                </div>
                <button class="btn btn-primary w-100" disabled="@_loading">Registrarse</button>
            </EditForm>
            <p class="mt-3 text-center">
                ¿Ya tiene cuenta? <a href="#" @onclick="ToggleModo" @onclick:preventDefault>Iniciar sesión</a>
            </p>
        }
        else
        {
            <EditForm Model="_login" OnValidSubmit="IniciarSesion">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_login.Email" @bind-Value:after="LimpiarError" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <InputText type="password" class="form-control" @bind-Value="_login.Password" @bind-Value:after="LimpiarError" />
                </div>
                <button class="btn btn-primary w-100" disabled="@_loading">Entrar</button>
            </EditForm>
            <p class="mt-3 text-center">
                ¿Nuevo estudiante? <a href="#" @onclick="ToggleModo" @onclick:preventDefault>Registrarse</a>
            </p>
        }
    </div>
</div>

@code {
    private LoginForm _login = new();
    private RegisterForm _register = new();
    private bool _registro;
    private bool _loading;
    private string? _error;

    private void LimpiarError() => _error = null;

    private void ToggleModo()
    {
        _registro = !_registro;
        _error = null;
    }

    private async Task IniciarSesion()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await AuthApi.LoginAsync(new LoginRequest(_login.Email, _login.Password));
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Credenciales inválidas.";
                return;
            }
            await JS.InvokeVoidAsync("authBridge.notifyLogin", result.Value);
        }
        finally { _loading = false; }
    }

    private async Task Registrar()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await AuthApi.RegisterAsync(new RegisterRequest(_register.Nombre, _register.Email, _register.Password));
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "No se pudo completar el registro.";
                return;
            }
            await JS.InvokeVoidAsync("authBridge.notifyLogin", result.Value);
        }
        finally { _loading = false; }
    }

    private sealed class LoginForm
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed class RegisterForm
    {
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
