@page "/"
@model Orquestador.Shell.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — Registro Estudiantes</title>
    <base href="~/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <script src="_content/Blazor.Shared/auth-bridge.js"></script>
    <script>
        shellAuth.initRelay();
        shellAuth.routeGuard();
        window.addEventListener('message', function (e) {
            if (e.data && e.data.type === 'registro-auth' && e.data.payload) {
                shellAuth.set(e.data.payload);
                location.replace('/home');
            }
        });
    </script>
</head>
<body class="login-body">
    <iframe src="@($"{Model.LoginUrl.TrimEnd('/')}/")"
            class="mf-frame mf-frame-login"
            title="Login"></iframe>
</body>
</html>
